<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: black screen with the logo, handed over to the animated
         Compose splash (see AmmiraSplash) so there is no white flash. -->
    <style name="Theme.AmmiraTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">#FF0A0A0C</item>
        <item name="android:statusBarColor">#FF0A0A0C</item>
        <item name="android:navigationBarColor">#FF0A0A0C</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>
</resources>

